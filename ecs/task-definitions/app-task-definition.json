{
  "family": "app-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::181684851258:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::181684851258:role/ecs-task-role-app",
  "requiresCompatibilities": [
    "EC2"
  ],
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "181684851258.dkr.ecr.sa-east-1.amazonaws.com/nginx:1.0.0",
      "essential": true,
      "cpu": 64,
      "memory": 96,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecs-nginx",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "user-service",
      "image": "181684851258.dkr.ecr.sa-east-1.amazonaws.com/user-service:latest",
      "essential": true,
      "cpu": 512,
      "memory": 758,
      "portMappings": [
        {
          "containerPort": 8081,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError"
        }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:DB_URL::"
        },
        {
          "name": "USER_DB",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:USER_DB::"
        },
        {
          "name": "PASSWORD_DB",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:PASSWORD_DB::"
        },
        {
          "name": "USER_DB_FLYWAY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:USER_DB_FLYWAY::"
        },
        {
          "name": "PASSWORD_DB_FLYWAY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:PASSWORD_DB_FLYWAY::"
        },
        {
          "name": "GITHUB_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GITHUB_CLIENT_ID::"
        },
        {
          "name": "GITHUB_CLIENT_REDIRECT_URI",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GITHUB_CLIENT_REDIRECT_URI::"
        },
        {
          "name": "GITHUB_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GITHUB_CLIENT_SECRET::"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GOOGLE_CLIENT_ID::"
        },
        {
          "name": "GOOGLE_CLIENT_REDIRECT_URI",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GOOGLE_CLIENT_REDIRECT_URI::"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:GOOGLE_CLIENT_SECRET::"
        },
        {
          "name": "DISCOVERY_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:DISCOVERY_ENABLED::"
        },
        {
          "name": "EUREKA_CLIENT_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:EUREKA_CLIENT_ENABLED::"
        },
        {
          "name": "FEIGN_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:FEIGN_ENABLED::"
        },
        {
          "name": "LOADBALANCER_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:LOADBALANCER_ENABLED::"
        },
        {
          "name": "REDIS_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:REDIS_ENABLED::"
        },
        {
          "name": "JWT_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:JWT_PRIVATE_KEY::"
        },
        {
          "name": "PUBLIC_KEY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:PUBLIC_KEY::"
        },
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:PORT::"
        },
        {
          "name": "SERVICOS_EXTERNOS_PERMITIDOS",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:users-service-secrets-gqOVGq:SERVICOS_EXTERNOS_PERMITIDOS::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8081/users/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecs-user-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "lista-service",
      "image": "181684851258.dkr.ecr.sa-east-1.amazonaws.com/lista-service:1.0.0",
      "essential": true,
      "cpu": 512,
      "memory": 768,
      "portMappings": [
        {
          "containerPort": 8082,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:DB_URL::"
        },
        {
          "name": "USER_DB",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:USER_DB::"
        },
        {
          "name": "PASSWORD_DB",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:PASSWORD_DB::"
        },
        {
          "name": "USER_DB_FLYWAY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:USER_DB_FLYWAY::"
        },
        {
          "name": "PASSWORD_DB_FLYWAY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:PASSWORD_DB_FLYWAY::"
        },
        {
          "name": "DISCOVERY_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:DISCOVERY_ENABLED::"
        },
        {
          "name": "EUREKA_CLIENT_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:EUREKA_CLIENT_ENABLED::"
        },
        {
          "name": "FEIGN_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:FEIGN_ENABLED::"
        },
        {
          "name": "LOADBALANCER_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:LOADBALANCER_ENABLED::"
        },
        {
          "name": "REDIS_ENABLED",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:REDIS_ENABLED::"
        },
        {
          "name": "PUBLIC_KEY",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:PUBLIC_KEY::"
        },
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:PORT::"
        },
        {
          "name": "SERVICOS_EXTERNOS_PERMITIDOS",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:181684851258:secret:lista-service-secrets-EsgNGu:SERVICOS_EXTERNOS_PERMITIDOS::"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8082/lista/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecs-lista-service",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
